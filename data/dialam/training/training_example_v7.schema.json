  "required": [
    "schema_version",
    "preference_row_id",
    "source_v5_training_row_id",
    "pair_group_id",
    "pair_role",
    "source_example_id",
    "update_id",
    "dialogue_id",
    "block_index",
    "candidate_target_id",
    "paired_candidate_target_id",
    "chosen_label",
    "rejected_label",
    "positive_label",
    "repetition_index",
    "is_repeated_positive",
    "negative_hardness",
    "messages"
  ],
  "title": "DialAMPreferenceRowV7",
  "type": "object"
