{
  "$defs": {
    "CandidateHardness": {
      "additionalProperties": false,
      "properties": {
        "jaccard_similarity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Jaccard Similarity",
          "type": "number"
        },
        "overlap_coefficient": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Overlap Coefficient",
          "type": "number"
        },
        "shared_content_tokens": {
          "minimum": 0,
          "title": "Shared Content Tokens",
          "type": "integer"
        },
        "turn_gap": {
          "exclusiveMinimum": 0,
          "title": "Turn Gap",
          "type": "integer"
        }
      },
      "required": [
        "shared_content_tokens",
        "overlap_coefficient",
        "jaccard_similarity",
        "turn_gap"
      ],
      "title": "CandidateHardness",
      "type": "object"
    },
    "DialAMMiningScoreV9": {
      "additionalProperties": false,
      "properties": {
        "adapter_tree_sha256": {
          "title": "Adapter Tree Sha256",
          "type": "string"
        },
        "decision_key": {
          "title": "Decision Key",
          "type": "string"
        },
        "label_scores": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Label Scores",
          "type": "object"
        },
        "mining_candidate_id": {
          "title": "Mining Candidate Id",
          "type": "string"
        },
        "model_hardness": {
          "title": "Model Hardness",
          "type": "number"
        },
        "schema_version": {
          "const": "dialam_selected_model_mining_score_v9",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_label": {
          "enum": [
            "NONE",
            "SUPPORT",
            "ATTACK",
            "REPHRASE"
          ],
          "title": "Selected Label",
          "type": "string"
        },
        "support_evidence": {
          "title": "Support Evidence",
          "type": "number"
        },
        "winning_positive_label": {
          "enum": [
            "SUPPORT",
            "ATTACK",
            "REPHRASE"
          ],
          "title": "Winning Positive Label",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "mining_candidate_id",
        "decision_key",
        "selected_label",
        "winning_positive_label",
        "label_scores",
        "model_hardness",
        "support_evidence",
        "adapter_tree_sha256"
      ],
      "title": "DialAMMiningScoreV9",
      "type": "object"
    },
    "TrainingMessage": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "TrainingMessage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "block_index": {
      "minimum": 0,
      "title": "Block Index",
      "type": "integer"
    },
    "candidate_hardness": {
      "anyOf": [
        {
          "$ref": "#/$defs/CandidateHardness"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "candidate_target_id": {
      "title": "Candidate Target Id",
      "type": "string"
    },
    "dialogue_id": {
      "title": "Dialogue Id",
      "type": "string"
    },
    "label": {
      "enum": [
        "NONE",
        "SUPPORT",
        "ATTACK",
        "REPHRASE"
      ],
      "title": "Label",
      "type": "string"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/TrainingMessage"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Messages",
      "type": "array"
    },
    "mining_score": {
      "anyOf": [
        {
          "$ref": "#/$defs/DialAMMiningScoreV9"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "row_role": {
      "enum": [
        "POSITIVE_REHEARSAL",
        "MINED_NONE"
      ],
      "title": "Row Role",
      "type": "string"
    },
    "schema_version": {
      "const": "dialam_qlora_model_error_corrective_v9",
      "title": "Schema Version",
      "type": "string"
    },
    "source_example_id": {
      "title": "Source Example Id",
      "type": "string"
    },
    "source_row_id": {
      "title": "Source Row Id",
      "type": "string"
    },
    "training_row_id": {
      "title": "Training Row Id",
      "type": "string"
    },
    "update_id": {
      "title": "Update Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "training_row_id",
    "row_role",
    "source_row_id",
    "source_example_id",
    "update_id",
    "dialogue_id",
    "block_index",
    "candidate_target_id",
    "label",
    "messages"
  ],
  "title": "DialAMTrainingRowV9",
  "type": "object"
}
